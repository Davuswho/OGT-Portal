# --- Required ---
ALCHEMY_KEY=                      # Alchemy NFT API key (app-scoped; does NOT expire). Primary source for wallet holdings + traits. Free at alchemy.com -> Create App -> Ethereum Mainnet.
SESSION_SECRET=                   # random 32+ byte hex; signs the SIWE session cookie. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Optional ---
OPENSEA_KEY=                      # OpenSea API v2 key. Fallback for holdings + source for live listings / offer-queue. (OpenSea keys can expire.) Stored without trailing CR.
OWNER_WALLET=                     # show an owner shortcut on landing (e.g. 0x2da4...:Davuswho)
WALLETCONNECT_PROJECT_ID=         # enables the mobile wallet-connect option (QR/app-link, for phones with no browser extensions). Free at dashboard.reown.com.
KV_REST_API_URL=                  # Upstash/Vercel KV REST endpoint — enables cross-device account sync
KV_REST_API_TOKEN=                # Upstash/Vercel KV REST token

# --- Defaults (per-collection configs can override) ---
DONATE_ETH=0x60Dca57feAE49aCCBD08Fa2B8B8cf67C99F34305
DONATE_STRIPE=https://buy.stripe.com/fZucN7fEl3ct3Z80kp93y00
